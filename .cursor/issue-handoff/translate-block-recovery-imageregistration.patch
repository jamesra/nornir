+"""Recovering a misplaced block of tiles after translate (translate_recovery).
+
+Tiles are cut from one smooth texture so overlaps really match. Two columns of a 6x6 grid are
+displaced as a block, as a stage error would; recovery must find the shift that puts them back
+and keep the result only when the mosaic then holds together.
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import tempfile
+import unittest
+from unittest import mock
+
+import numpy as np
+import scipy.ndimage
+from PIL import Image
+
+import nornir_imageregistration
+import nornir_imageregistration.transforms.factory as tfactory
+from nornir_imageregistration import translate_recovery
+from nornir_imageregistration.translate_recovery import (
+    _masked_ncc,
+    estimate_block_offset,
+)
+
+_TILE = 128
+_STEP = 96  # 32 px (25%) overlap between neighbours
+_GRID = 6
+_MOVED_COLUMNS = (4, 5)  # 12 tiles: a secondary block (MIN_SECONDARY_BLOCK_TILES is 10)
+
+
+def _true_position(tile_id: int) -> np.ndarray:
+    row, col = divmod(tile_id, _GRID)
+    return np.array([row * _STEP, col * _STEP], dtype=np.float64)
+
+
+def _settings():
+    return nornir_imageregistration.settings.TranslateSettings(
+        min_overlap=0.05, max_relax_iterations=50, max_translate_iterations=2,
+        feature_score_threshold=None, use_feature_score=False)
+
+
+class TestMaskedNcc(unittest.TestCase):
+
+    def test_the_peak_is_the_shift_that_moves_the_moving_image_onto_the_fixed_one(self):
+        texture = scipy.ndimage.gaussian_filter(np.random.default_rng(3).random((96, 96)), 1.5)
+        fixed_mask = np.zeros_like(texture, dtype=bool)
+        fixed_mask[:, :60] = True
+        # The moving block is the right part of the texture, displaced by (7, -5).
+        shifted = np.roll(texture, (7, -5), axis=(0, 1))
+        moving_mask = np.zeros_like(texture, dtype=bool)
+        moving_mask[10:80, 40:85] = True
+        ncc, _ = _masked_ncc(texture, fixed_mask, shifted, moving_mask, radius=12, min_overlap=200)
+        best = np.array(np.unravel_index(np.nanargmax(ncc), ncc.shape)) - 12
+        np.testing.assert_array_equal([-7, 5], best)
+        self.assertGreater(np.nanmax(ncc), 0.99)
+
+
+class _GridTiles(unittest.TestCase):
+
+    def setUp(self):
+        self.tmpdir = tempfile.mkdtemp(prefix='test_translate_recovery_')
+        self.addCleanup(shutil.rmtree, self.tmpdir, ignore_errors=True)
+        size = _STEP * (_GRID - 1) + _TILE
+        texture = scipy.ndimage.gaussian_filter(np.random.default_rng(11).random((size, size)), 3.0)
+        texture = (texture - texture.min()) / (texture.max() - texture.min())
+        self.paths = []
+        for tile_id in range(_GRID * _GRID):
+            y, x = _true_position(tile_id).astype(int)
+            path = os.path.join(self.tmpdir, f'Tile{tile_id:05d}.png')
+            Image.fromarray((texture[y:y + _TILE, x:x + _TILE] * 255).astype(np.uint8)).save(path)
+            self.paths.append(path)
+        # Compare blocks at 4 px per pixel instead of 32: these tiles are 128 px.
+        patcher = mock.patch.object(translate_recovery, 'TARGET_DOWNSAMPLE', 4.0)
+        patcher.start()
+        self.addCleanup(patcher.stop)
+
+    @staticmethod
+    def moved(tile_id: int) -> bool:
+        return tile_id % _GRID in _MOVED_COLUMNS
+
+    def tileset(self, displacement):
+        shape = np.array((_TILE, _TILE))
+        transforms = [tfactory.CreateRigidTransform(
+            target_image_shape=shape, source_image_shape=shape, rangle=0,
+            warped_offset=_true_position(i) + (np.asarray(displacement) if self.moved(i) else 0))
+            for i in range(_GRID * _GRID)]
+        return nornir_imageregistration.mosaic_tileset.Create(transforms=transforms, imagepaths=self.paths,
+                                                              image_to_source_space_scale=1.0)
+
+    @staticmethod
+    def relative_error(tileset) -> float:
+        origin = np.asarray(tileset[0].FixedBoundingBox.BottomLeft)
+        return max(float(np.max(np.abs(np.asarray(t.FixedBoundingBox.BottomLeft) - origin - _true_position(i))))
+                   for i, t in tileset.items())
+
+
+class TestEstimateBlockOffset(_GridTiles):
+
+    def test_a_displaced_block_is_shifted_back(self):
+        tileset = self.tileset((80, -40))
+        moving = {i for i in range(_GRID * _GRID) if self.moved(i)}
+        estimate = estimate_block_offset(tileset, set(range(_GRID * _GRID)) - moving, moving)
+        assert estimate is not None
+        np.testing.assert_allclose([-80, 40], estimate.offset, atol=2)
+        self.assertGreater(estimate.ncc, 0.9)
+        self.assertFalse(estimate.at_search_edge)
+
+    def test_a_block_in_place_needs_no_shift(self):
+        tileset = self.tileset((0, 0))
+        moving = {i for i in range(_GRID * _GRID) if self.moved(i)}
+        estimate = estimate_block_offset(tileset, set(range(_GRID * _GRID)) - moving, moving)
+        assert estimate is not None
+        np.testing.assert_allclose([0, 0], estimate.offset, atol=2)
+
+
+class TestRecoverMisplacedBlocks(_GridTiles):
+    """Recovery from a layout whose block is intact but misplaced, as translate leaves it after a
+    stage error (RC3 0800 with a third of its tiles moved 5,000 px: block returned and joined)."""
+
+    # Translate itself lands a few px from the true layout on these small tiles.
+    TOLERANCE = 6.0
+
+    def misplaced(self):
+        tileset = self.tileset((200, 60))
+        report = nornir_imageregistration.TranslateReport(groups=[list(range(_GRID * _GRID))])
+        report.check_joins(tileset, min_overlap=0.05)
+        return tileset, report
+
+    def test_the_check_sees_the_block(self):
+        _, report = self.misplaced()
+        self.assertEqual([12], [len(b) for b in report.secondary_blocks])
+
+    def test_the_block_is_put_back_and_joined(self):
+        tileset, report = self.misplaced()
+        recovered, final = translate_recovery.recover_misplaced_blocks(tileset, report, _settings())
+        self.assertLess(self.relative_error(recovered), self.TOLERANCE)
+        self.assertEqual([True], [a['accepted'] for a in final.recovery_attempts], final.recovery_attempts)
+        self.assertEqual([], final.secondary_blocks)
+
+    def test_a_rejected_attempt_keeps_the_original_layout(self):
+        tileset, report = self.misplaced()
+        with mock.patch.object(translate_recovery, '_improved', return_value=(False, 'rejected for the test')):
+            recovered, final = translate_recovery.recover_misplaced_blocks(tileset, report, _settings())
+        self.assertIs(tileset, recovered)
+        self.assertEqual(['rejected for the test'], [a['outcome'] for a in final.recovery_attempts])
+
+
+class TestRecoveryWiring(_GridTiles):
+    """ArrangeTilesWithTranslate runs recovery only when the join check flags the section."""
+
+    def run_with(self, needs_review: bool, env: dict[str, str] | None = None):
+        def check(report, *args, **kwargs):
+            report.review_reasons = ['flagged for the test'] if needs_review else []
+
+        report = nornir_imageregistration.TranslateReport()
+        with mock.patch.object(nornir_imageregistration.TranslateReport, 'check_joins', autospec=True,
+                               side_effect=check), \
+                mock.patch.object(translate_recovery, 'recover_misplaced_blocks',
+                                  side_effect=lambda t, r, c: (t, r)) as recover, \
+                mock.patch.dict(os.environ, env or {}):
+            self.tileset((0, 0)).ArrangeTilesWithTranslate(_settings(), report=report)
+        return recover
+
+    def test_a_flagged_section_is_recovered(self):
+        self.run_with(needs_review=True).assert_called_once()
+
+    def test_a_section_that_holds_together_is_left_alone(self):
+        self.run_with(needs_review=False).assert_not_called()
+
+    def test_recovery_can_be_turned_off(self):
+        self.run_with(needs_review=True, env={'NORNIR_TRANSLATE_RECOVER_BLOCKS': '0'}).assert_not_called()
+
+
+if __name__ == '__main__':
+    unittest.main()
