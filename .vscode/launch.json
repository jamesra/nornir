        {
            "name": "TEM Build: Prune",
            "type": "debugpy",
            "request": "launch",
            "module": "nornir_buildmanager.build",
            "python": "${command:python.interpreterPath}",
            "pythonArgs": ["-Xfrozen_modules=off"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "redirectOutput": true,
            "args": [
                "-debug", "-computational_library", "cupy",
                "/volumes/${input:nornirVolumeName}",
                "Prune", "-InputFilter", "Raw8", "-Downsample", "4", "-Channels", "TEM", "-DefaultThreshold", "10.0"
            ],
            "env": { "NORNIR_HEADLESS": "1", "PYTHONUNBUFFERED": "1" }
        },
