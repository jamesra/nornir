{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug Tests",
            "type": "debugpy",
            "request": "launch",
            "purpose": ["debug-test"],
            "console": "internalConsole",
            "justMyCode": false,
            "subProcess": false,
            "redirectOutput": true,
            "python": "${command:python.interpreterPath}",
            "pythonArgs": ["-Xfrozen_modules=off"],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/nornir-buildmanager;${workspaceFolder}/nornir-imageregistration;${workspaceFolder}/nornir-pools;${workspaceFolder}/nornir-shared;${workspaceFolder}/nornir-pyre;${env:PYTHONPATH}",
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "pyre",
            "type": "debugpy",
            "subProcess": true,
            "request": "launch",
            "module": "pyre",
            "python": "${command:python.interpreterPath}",
            "pythonArgs": ["-Xfrozen_modules=off"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": ["-stos", "Y:\\Volumes\\RC2\\TEM\\Grid16\\401-402_ctrl-TEM_Leveled_map-TEM_Leveled.stos"],
            "redirectOutput": true,
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/nornir-pyre;${workspaceFolder}/nornir-imageregistration;${workspaceFolder}/nornir-pools;${workspaceFolder}/nornir-shared;${workspaceFolder}/nornir-buildmanager",
                "DEBUG": "1",
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "pyre (with stos arg)",
            "type": "debugpy",
            "subProcess": true,
            "request": "launch",
            "module": "pyre",
            "python": "${command:python.interpreterPath}",
            "pythonArgs": ["-Xfrozen_modules=off"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "redirectOutput": true,
            "justMyCode": false,
            "args": ["-stos", "${input:pyreStosPath}"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/nornir-pyre;${workspaceFolder}/nornir-imageregistration;${workspaceFolder}/nornir-pools;${workspaceFolder}/nornir-shared;${workspaceFolder}/nornir-buildmanager",
                "DEBUG": "1",
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Tests: nornir-imageregistration",
            "type": "debugpy",
            "subProcess": true,
            "request": "launch",
            "module": "pytest",
            "python": "${command:python.interpreterPath}",
            "pythonArgs": ["-Xfrozen_modules=off"],
            "cwd": "${workspaceFolder}/nornir-imageregistration",
            "console": "internalConsole",
            "redirectOutput": true,
            "justMyCode": false,
            "args": ["tests", "-v"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/nornir-imageregistration/tests;${workspaceFolder}/nornir-imageregistration;${workspaceFolder}/nornir-pools;${workspaceFolder}/nornir-shared;${workspaceFolder}/nornir-buildmanager;${workspaceFolder}/nornir-pyre",
                "NORNIR_HEADLESS": "1",
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Tests: nornir-buildmanager",
            "type": "debugpy",
            "subProcess": true,
            "request": "launch",
            "module": "pytest",
            "python": "${command:python.interpreterPath}",
            "pythonArgs": ["-Xfrozen_modules=off"],
            "cwd": "${workspaceFolder}/nornir-buildmanager",
            "console": "internalConsole",
            "redirectOutput": true,
            "justMyCode": false,
            "args": ["tests", "-v"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/nornir-buildmanager/tests;${workspaceFolder}/nornir-buildmanager;${workspaceFolder}/nornir-imageregistration/tests;${workspaceFolder}/nornir-imageregistration;${workspaceFolder}/nornir-pools;${workspaceFolder}/nornir-shared;${workspaceFolder}/nornir-pyre",
                "NORNIR_HEADLESS": "1",
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Tests: nornir-shared",
            "type": "debugpy",
            "subProcess": true,
            "request": "launch",
            "module": "pytest",
            "python": "${command:python.interpreterPath}",
            "pythonArgs": ["-Xfrozen_modules=off"],
            "cwd": "${workspaceFolder}/nornir-shared",
            "console": "internalConsole",
            "redirectOutput": true,
            "justMyCode": false,
            "args": ["tests", "-v"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/nornir-shared",
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Debug tests: nornir-pools only",
            "type": "debugpy",
            "subProcess": true,
            "request": "launch",
            "module": "pytest",
            "python": "${command:python.interpreterPath}",
            "pythonArgs": ["-Xfrozen_modules=off"],
            "cwd": "${workspaceFolder}/nornir-pools",
            "console": "internalConsole",
            "redirectOutput": true,
            "justMyCode": false,
            "args": [
                "tests",
                "-v",
                "--import-mode=prepend",
                "--rootdir",
                "${workspaceFolder}/nornir-pools"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/nornir-pools:${workspaceFolder}/nornir-shared:${env:PYTHONPATH}",
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Tests: dm4",
            "type": "debugpy",
            "subProcess": true,
            "request": "launch",
            "module": "pytest",
            "python": "${command:python.interpreterPath}",
            "pythonArgs": ["-Xfrozen_modules=off"],
            "cwd": "${workspaceFolder}/dm4",
            "console": "internalConsole",
            "redirectOutput": true,
            "justMyCode": false,
            "args": ["tests", "-v"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/dm4",
                "PYTHONUNBUFFERED": "1"
            }
        }
    ],
    "inputs": [
        {
            "id": "pyreStosPath",
            "type": "promptString",
            "description": "Path to STOS file",
            "default": "Y:\\Volumes\\RC2\\TEM\\Grid16\\401-402_ctrl-TEM_Leveled_map-TEM_Leveled.stos"
        }
    ]
}
